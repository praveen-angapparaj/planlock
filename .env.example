PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENV=sandbox
# Render's PORT is honored when supplied. BACKEND_PORT is the local fallback.
BACKEND_PORT=3001
# Use this only for a split deployment. Leave unset for the combined same-origin Render application.
ALLOWED_FRONTEND_ORIGIN=http://localhost:5173
# Public browser API origin. Leave blank for local Vite proxy and the combined Render application.
VITE_API_BASE_URL=
LOCAL_SESSION_SECRET=replace_with_a_random_32_character_or_longer_secret
NODE_ENV=development

# Enables PostgreSQL runtime repositories. Leave unset only for the local SQLite demo.
# Run versioned migrations before starting a PostgreSQL process.
DATABASE_URL=

# PayPal Sandbox webhook configuration. Register https://YOUR_API/api/paypal/webhook on the same Sandbox REST app.
PAYPAL_WEBHOOK_ID=
PAYPAL_SELLER_MERCHANT_ID=

# Render Workflows dispatch. Never place either value in VITE_ variables.
RENDER_API_KEY=
RENDER_WORKFLOW_TASK=planlock-recovery/processRecovery
RENDER_RECONCILE_TASK=planlock-recovery/reconcileDueWork

# Optional: enables the Groq proposal button in Plan workspace.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: enables the Gemini proposal button instead of Groq when set. The key stays server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional public AG Studio licence key for the embedded local dashboard.
# Do not place LLM provider secrets in VITE_ variables.
VITE_AG_STUDIO_LICENSE_KEY=
